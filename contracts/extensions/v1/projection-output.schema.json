{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 8192,
            "x-maxUtf8Bytes": 8192,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "maxLength": 8192,
            "x-maxUtf8Bytes": 8192,
            "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "x-inputSourceIds": true
          },
          "table": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "columns": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1024,
                "items": {
                  "type": "string",
                  "maxLength": 8192,
                  "x-maxUtf8Bytes": 8192,
                  "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
                }
              },
              "rows": {
                "type": "array",
                "maxItems": 1024,
                "items": {
                  "type": "array",
                  "maxItems": 1024,
                  "items": {
                    "type": "string",
                    "maxLength": 8192,
                    "x-maxUtf8Bytes": 8192,
                    "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
                  }
                }
              }
            },
            "required": [
              "columns",
              "rows"
            ],
            "x-rectangularRows": true
          }
        },
        "required": [
          "title",
          "body",
          "sourceIds"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "sections"
  ],
  "x-maxBytes": 262144,
  "x-maxTableCells": 1024,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ariadne.local/contracts/extensions/v1/projection-output.schema.json"
}
